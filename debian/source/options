tar-ignore = "tests/bio_write_test.txt"
tar-ignore = "tests/*.tmp"
tar-ignore = "wolfcrypt/benchmark/*.info"
tar-ignore = "certeccrsa.der"
tar-ignore = "*.gcda"
tar-ignore = "*.gcno"
tar-ignore = "*.gcov"
tar-ignore = "*.profdata"
tar-ignore = "build-aux/ltmain.sh"
tar-ignore = "m4/libtool.m4"
tar-ignore = "m4/ltoptions.m4"
