# Debian source package options
# This file controls how dpkg-source handles the source package

# Extend diff ignore list to exclude build artifacts
extend-diff-ignore = "^[^/]*\.o$"
extend-diff-ignore = "^[^/]*\.lo$"
extend-diff-ignore = "^[^/]*\.la$"
extend-diff-ignore = "^[^/]*\.so$"
extend-diff-ignore = "^[^/]*\.so\.[0-9]+$"
extend-diff-ignore = "^[^/]*\.so\.[0-9]+\.[0-9]+$"
extend-diff-ignore = "^[^/]*\.so\.[0-9]+\.[0-9]+\.[0-9]+$"
extend-diff-ignore = "^wrapper/Ada/obj/"
extend-diff-ignore = "^wrapper/Ada/lib/"
extend-diff-ignore = "^\.libs/"
extend-diff-ignore = "^src/\.libs/"
extend-diff-ignore = "^wolfcrypt/src/\.libs/"
extend-diff-ignore = "^[^/]*\.stdout$"
extend-diff-ignore = "^[^/]*\.stderr$"
extend-diff-ignore = "^config\.log$"
extend-diff-ignore = "^config\.status$"
extend-diff-ignore = "^libtool$"
extend-diff-ignore = "^stamp-h[0-9]*$"
extend-diff-ignore = "^\.build_params$"
extend-diff-ignore = "^Makefile$"
extend-diff-ignore = "^[^/]*~$"
extend-diff-ignore = "^\.deps/"
extend-diff-ignore = "^\.dirstamp$"
extend-diff-ignore = "^autom4te\.cache/"
extend-diff-ignore = "^out.*\.log$"
extend-diff-ignore = "^test\.log$"
extend-diff-ignore = "^certeccrsa\.der$"
extend-diff-ignore = "^tests/bio_write_test\.txt$"
extend-diff-ignore = "^tests/cert_cache\.tmp$"
extend-diff-ignore = "^wolfcrypt/benchmark/benchmark\.info$"
extend-diff-ignore = "^wolfssl-.*\.tar\.gz$"
extend-diff-ignore = "^aminclude\.am$"
extend-diff-ignore = "^build-aux/ltmain\.sh$"
extend-diff-ignore = "^m4/libtool\.m4$"
extend-diff-ignore = "^m4/ltoptions\.m4$"
extend-diff-ignore = "^m4/ltsugar\.m4$"
extend-diff-ignore = "^m4/ltversion\.m4$"
extend-diff-ignore = "^m4/lt~obsolete\.m4$"
extend-diff-ignore = "^aclocal\.m4$"
extend-diff-ignore = "^support/wolfssl\.pc$"
extend-diff-ignore = "^wolfssl-config$"
extend-diff-ignore = "^wolfssl/options\.h$"
extend-diff-ignore = "^config\.in$"
extend-diff-ignore = "^wolfcrypt/src/fips_test\.c$"
extend-diff-ignore = "^wolfcrypt/src/wolfcrypt_first\.c$"
extend-diff-ignore = "^wolfcrypt/src/wolfcrypt_last\.c$"
extend-diff-ignore = "^wolfcrypt/test/test_paths\.h$"
extend-diff-ignore = "^rpm/spec$"
extend-diff-ignore = "^certeccrsa\.pem$"
extend-diff-ignore = "^ecc-key\.pem$"
extend-diff-ignore = "^test-write-dhparams\.pem$"

# Tar ignore patterns for creating orig tarball
tar-ignore = "*.o"
tar-ignore = "*.lo"
tar-ignore = "*.la"
tar-ignore = "*.so"
tar-ignore = "*.so.*"
tar-ignore = ".libs"
tar-ignore = "wrapper/Ada/obj"
tar-ignore = "wrapper/Ada/lib"
tar-ignore = "*.stdout"
tar-ignore = "*.stderr"
tar-ignore = "config.log"
tar-ignore = "config.status"
tar-ignore = "libtool"
tar-ignore = "stamp-h*"
tar-ignore = ".build_params"
tar-ignore = "Makefile"
tar-ignore = "*~"
tar-ignore = ".deps"
tar-ignore = ".dirstamp"
tar-ignore = "autom4te.cache"
