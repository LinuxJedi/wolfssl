#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# These are used for cross-compiling and for saving the configure script
# from having to guess our platform (since we know it already)
DEB_HOST_GNU_TYPE   ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_BUILD_GNU_TYPE  ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)

# Configure options as specified
CONFIGURE_OPTIONS = \
	--enable-opensslcoexist \
	--enable-cmac \
	--with-eccminsz=192 \
	--enable-ed25519 \
	--enable-ed448 \
	--enable-md5 \
	--enable-curve25519 \
	--enable-curve448 \
	--enable-aesccm \
	--enable-aesxts \
	--enable-aescfb \
	--enable-keygen \
	--enable-shake128 \
	--enable-shake256 \
	--enable-wolfprovider \
	--enable-rsapss \
	--enable-scrypt

# CFLAGS as specified
export CFLAGS += -DWOLFSSL_OLD_OID_SUM \
	-DWOLFSSL_PUBLIC_ASN \
	-DHAVE_FFDHE_3072 \
	-DHAVE_FFDHE_4096 \
	-DWOLFSSL_DH_EXTRA \
	-DWOLFSSL_PSS_SALT_LEN_DISCOVER \
	-DWOLFSSL_PUBLIC_MP \
	-DWOLFSSL_RSA_KEY_CHECK \
	-DHAVE_FFDHE_Q \
	-DHAVE_FFDHE_6144 \
	-DHAVE_FFDHE_8192 \
	-DWOLFSSL_ECDSA_DETERMINISTIC_K \
	-DWOLFSSL_VALIDATE_ECC_IMPORT \
	-DRSA_MIN_SIZE=1024 \
	-DHAVE_AES_ECB \
	-DWC_RSA_DIRECT \
	-DWC_RSA_NO_PADDING \
	-DACVP_VECTOR_TESTING \
	-DWOLFSSL_ECDSA_SET_K

%:
	dh $@

override_dh_auto_configure:
	./configure \
		--build=$(DEB_BUILD_GNU_TYPE) \
		--host=$(DEB_HOST_GNU_TYPE) \
		--prefix=/usr \
		--mandir=\$${prefix}/share/man \
		--infodir=\$${prefix}/share/info \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=\$${prefix}/lib/$(DEB_HOST_MULTIARCH) \
		--libexecdir=\$${prefix}/lib/$(DEB_HOST_MULTIARCH) \
		--disable-maintainer-mode \
		--disable-dependency-tracking \
		--enable-shared \
		--enable-static \
		$(CONFIGURE_OPTIONS)

override_dh_auto_test:
	# Skip tests for now - they may require special setup
	# dh_auto_test

override_dh_auto_clean:
	# Don't run make clean or distclean - just manually clean artifacts
	# Remove configure-generated files
	rm -f config.status config.log config.h stamp-h stamp-h1 libtool .build_params
	rm -f Makefile src/Makefile wolfcrypt/Makefile wolfcrypt/src/Makefile
	# Remove all object files and libraries
	find . -name "*.o" -delete || true
	find . -name "*.lo" -delete || true
	find . -name "*.la" -delete || true
	find . -name "*.so" -delete || true
	find . -name "*.so.*" -delete || true
	# Remove build directories
	rm -rf .libs src/.libs wolfcrypt/src/.libs || true
	rm -rf wrapper/Ada/obj wrapper/Ada/lib || true
	# Remove other build artifacts
	find . -name "*.stdout" -delete || true
	find . -name "*.stderr" -delete || true
	find . -name "*~" -delete || true
	find . -name ".deps" -type d -exec rm -rf {} + || true
	find . -name ".dirstamp" -delete || true
	rm -f out*.log test.log || true
	# Remove binary test files and artifacts that cause dpkg-source issues
	rm -f certeccrsa.der || true
	rm -f tests/bio_write_test.txt || true
	rm -f tests/*.tmp || true
	rm -f wolfcrypt/benchmark/*.info || true
	rm -f wolfssl-*.tar.gz || true
	rm -f aminclude.am || true
	# Remove coverage files
	find . -name "*.gcda" -delete || true
	find . -name "*.gcno" -delete || true
	find . -name "*.gcov" -delete || true
	find . -name "*.profdata" -delete || true
	# Remove autogenerated files that can cause upstream sync issues
	rm -f build-aux/ltmain.sh || true
	rm -f m4/libtool.m4 m4/ltoptions.m4 m4/ltsugar.m4 m4/ltversion.m4 m4/lt~obsolete.m4 || true
	rm -f aclocal.m4 || true
	rm -f support/wolfssl.pc wolfssl-config wolfssl/options.h config.in || true
	rm -f wolfcrypt/src/fips_test.c wolfcrypt/src/wolfcrypt_first.c wolfcrypt/src/wolfcrypt_last.c || true
	rm -f wolfcrypt/test/test_paths.h rpm/spec || true
	rm -f certeccrsa.pem ecc-key.pem test-write-dhparams.pem || true

override_dh_install:
	dh_install
	# Remove .la files as per Debian policy
	find debian/tmp -name '*.la' -delete || true

override_dh_makeshlibs:
	dh_makeshlibs -V
